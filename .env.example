# Telegram Bot (required)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# SSH tunnel to the PostgreSQL host (required)
SSH_HOST=your.server.example.com
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/id_rsa

# PostgreSQL (required; host/port as seen from the SSH host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=breakout
DB_USER=breakout
DB_PASSWORD=your_db_password_here

# Screening (optional)
# USE_DYNAMIC_SCREENING=true
# MAX_STOCKS=100

# Signal detection (optional)
# MIN_VOLUME_SURGE=50.0
# MAX_BREAKOUT_PCT=5.0

# Position management (optional)
# STOP_LOSS_PCT=0.08
# TAKE_PROFIT_PCT=0.20
